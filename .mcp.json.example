{
  "mcpServers": {
    "second-reader": {
      "command": "node",
      "args": ["dist/index.js"],
      "env": {
        "DATABASE_URL": "${SECOND_READER_DATABASE_URL}",
        "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}",
        "VOYAGE_API_KEY": "${VOYAGE_API_KEY}",
        "TRANSPORT": "stdio",
        "LOG_LEVEL": "info"
      }
    }
  }
}
