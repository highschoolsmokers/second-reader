# Copy to .env and fill in the three required values. .env is gitignored.
# The server also reads this file from ~/workspace/second-reader-mcp/.env or
# from the path in SECOND_READER_ENV_PATH. Values set in .mcp.json "env" win.

# --- Required ---------------------------------------------------------------

# Neon Postgres connection string. scripts/setup-db.ts enables pgvector.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Anthropic API key, used by the extraction and verification pipeline.
ANTHROPIC_API_KEY=

# Voyage AI API key, used for embeddings.
VOYAGE_API_KEY=

# --- Optional (commented values are the defaults) ---------------------------

# Higher rate limits for Semantic Scholar lookups.
# SEMANTIC_SCHOLAR_API_KEY=

# Claude model for extraction and fidelity checks. The default model runs
# with thinking off at low effort; any other model gets a plain request.
# CLAUDE_MODEL=claude-sonnet-5-5

# Verification thresholds.
# QUOTATION_SIMILARITY_THRESHOLD=0.85
# CHARACTER_LIMIT=8000
# MAX_CITATIONS_PER_VERIFY=15

# debug, info, warn, or error.
# LOG_LEVEL=info

# Transport: stdio (Claude Code) or http (remote or Docker).
# TRANSPORT=stdio

# HTTP transport only. Set both SSL paths to serve HTTPS.
# PORT=3000
# SSL_CERT_PATH=
# SSL_KEY_PATH=

# Paperless-ngx integration for document archival and retrieval.
# PAPERLESS_URL=http://localhost:8000
# PAPERLESS_TOKEN=
